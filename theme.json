{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 3,
	"settings": {
		"appearanceTools": false,
		"color": {
			"custom": false,
			"customDuotone": false,
			"customGradient": false,
			"defaultPalette": false,
			"defaultDuotone": false,
			"defaultGradients": false
		},
		"layout": {
			"contentSize": "680px",
			"wideSize": "1560px"
		},
		"spacing": {
			"margin": false,
			"padding": false
		},
		"typography": {
			"customFontSize": false,
			"dropCap": false,
			"fluid": true
		}
	},
	"styles": {
		"color": {
			"text": "#fbeeda"
		},
		"elements": {
			"heading": {
				"typography": {
					"fontWeight": "400",
					"lineHeight": ".95"
				}
			}
		}
	}
}
